<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_teleop</name>
  <version>0.1.0</version>
  <description>Alicia-D-ROS2 to UR10e+Robotiq teleoperation with LeRobot data collection</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>python3-yaml</depend>
  <depend>python3-numpy</depend>
  <depend>trajectory_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>data_collection</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>joint_impedance_controller</exec_depend>
  <exec_depend>robotiq_ft_sensor_hardware</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <!-- lerobot 可选：record 模式需要，source /opt/lerobot_venv/bin/activate（纯逻辑模块不依赖） -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
