<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <!--
    The kinematic model is kept in the user-owned description package.  This
    wrapper owns only the integration-specific ros2_control systems, so the
    upstream UR, Robotiq gripper, and Robotiq FT packages remain untouched.
  -->
  <xacro:arg name="name" default="ur10e_robotiq_ft"/>
  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="mock_sensor_commands" default="false"/>
  <xacro:arg name="gripper_com_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="ft_use_fake_mode" default="false"/>
  <xacro:arg name="ft_max_retries" default="100"/>
  <xacro:arg name="ft_read_rate" default="10"/>
  <xacro:arg name="ftdi_id" default="_"/>

  <!-- Forward every UR argument expected by the original combined model. -->
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="script_filename" default=""/>
  <xacro:arg name="output_recipe_filename" default=""/>
  <xacro:arg name="input_recipe_filename" default=""/>
  <xacro:arg name="reverse_ip" default="0.0.0.0"/>
  <xacro:arg name="script_command_port" default="50004"/>
  <xacro:arg name="reverse_port" default="50001"/>
  <xacro:arg name="script_sender_port" default="50002"/>
  <xacro:arg name="trajectory_port" default="50003"/>
  <xacro:arg name="verify_robot_model" default="false"/>
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="use_tool_communication" default="false"/>
  <xacro:arg name="tool_voltage" default="0"/>
  <xacro:arg name="tool_parity" default="0"/>
  <xacro:arg name="tool_baud_rate" default="115200"/>
  <xacro:arg name="tool_stop_bits" default="1"/>
  <xacro:arg name="tool_rx_idle_chars" default="1.5"/>
  <xacro:arg name="tool_tx_idle_chars" default="3.5"/>
  <xacro:arg name="tool_device_name" default="/tmp/ttyUR"/>
  <xacro:arg name="tool_tcp_port" default="54321"/>

  <xacro:include filename="$(find ur10e_robotiq_ft_description)/urdf/ur10e_robotiq_ft.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/2f_85.ros2_control.xacro"/>
  <xacro:include filename="$(find robotiq_ft_sensor_description)/urdf/robotiq_fts.ros2_control.xacro"/>

  <!-- The included description creates the UR hardware system and geometry. -->
  <!-- The included model already creates this fake system in mock mode. -->
  <xacro:unless value="$(arg use_mock_hardware)">
    <xacro:robotiq_gripper_ros2_control
        name="robotiq_2f85" prefix=""
        use_fake_hardware="false"
        com_port="$(arg gripper_com_port)"/>
  </xacro:unless>
  <xacro:robotiq_fts_ros2_control
      name="ft300_" tf_prefix=""
      use_fake_mode="$(arg ft_use_fake_mode)"
      max_retries="$(arg ft_max_retries)"
      read_rate="$(arg ft_read_rate)"
      ftdi_id="$(arg ftdi_id)"/>
</robot>
